{
  "name": "aria-lab",
  "version": "0.1.0-beta.2",
  "description": "React Aria component library with full accessibility",
  "homepage": "https://github.com/timurmaio/aria-lab#readme",
  "bugs": {
    "url": "https://github.com/timurmaio/aria-lab/issues"
  },
  "license": "MIT",
  "author": "Timur Makarov <timurmaio@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timurmaio/aria-lab.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./theme": "./dist/theme/index.css",
    "./theme/index.css": "./dist/theme/index.css",
    "./theme/tokens": "./dist/theme/tokens.css",
    "./theme/tokens.css": "./dist/theme/tokens.css",
    "./theme/default": "./dist/theme/default.css",
    "./theme/default.css": "./dist/theme/default.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --copy src/theme && vp run build:styles",
    "build:styles": "vp exec tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "release": "vp exec bumpp && vp pm publish",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "happy-dom": "20.11.2",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-aria-components": ">=1.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-aria-components": {
      "optional": false
    }
  }
}
